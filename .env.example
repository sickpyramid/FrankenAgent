# ReaFuse configuration. Copy to .env (CLI/web) or deploy/.env (Docker) and fill in what you use.

# Which brain answers the reasoning stages:
#   auto       Anthropic API if a key is set, else a logged-in Claude CLI, else handoff
#   claude-cli your Claude subscription via the Claude Code CLI (run `claude` once and /login)
#   anthropic  Anthropic API key below
#   kilo       Kilo Gateway (free models work without a key)
#   hybrid     Kilo for lookups/specs/concepts, Claude CLI for contract/grow/repair, each falling back to the other
#   handoff    write each request to disk for an agent or a human to answer
REAFUSE_BRAIN=auto

# Anthropic API (brain: anthropic or auto)
ANTHROPIC_API_KEY=

# Kilo Gateway (brain: kilo or hybrid). Free models such as kilo-auto/free need no key.
REAFUSE_KILO_MODEL=kilo-auto/free
KILO_API_KEY=

# Claude CLI (brain: claude-cli or hybrid). Optional overrides.
REAFUSE_CLAUDE_MODEL=
REAFUSE_CLAUDE_BIN=

# Optional: GitHub token for faster app-name lookups (search allows 10/min anonymously, 30/min with a token)
GITHUB_TOKEN=

# Web lab
PORT=4400
REAFUSE_LAB=.reafuse
REAFUSE_MAX_CONCURRENT=1
REAFUSE_RUNS_PER_HOUR=6

# Docker only: where the published port binds (host:port)
REAFUSE_BIND=127.0.0.1:4400
