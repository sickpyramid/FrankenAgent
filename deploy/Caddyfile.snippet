# ReaFuse web lab (append to the host's Caddyfile)
reafuse.140-82-32-12.sslip.io {
  encode gzip
  header -Server
  reverse_proxy 172.17.0.1:8090 {
    flush_interval -1
  }
}

# Old address from the FrankenAgent days
franken.140-82-32-12.sslip.io {
  redir https://reafuse.140-82-32-12.sslip.io{uri} permanent
}
