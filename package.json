{
  "name": "reafuse",
  "version": "0.1.0",
  "description": "Built on REA (Reverse Engineer Anything): dissect two projects, fuse their capabilities, and grow a brand-new verified creature.",
  "type": "module",
  "bin": {
    "reafuse": "bin/reafuse.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "web",
    "skills",
    ".env.example",
    "showcase"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node bin/reafuse.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "lab": "node --env-file-if-exists=.env web/server.mjs",
    "mcp": "node --env-file-if-exists=.env bin/reafuse.mjs mcp",
    "doctor": "node --env-file-if-exists=.env bin/reafuse.mjs doctor",
    "rea:doctor": "rea doctor --json"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@modelcontextprotocol/server": "2.3.1",
    "rea-agents": "6.4.0",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sickpyramid/ReaFuse.git"
  },
  "homepage": "https://github.com/sickpyramid/ReaFuse#readme",
  "bugs": {
    "url": "https://github.com/sickpyramid/ReaFuse/issues"
  },
  "keywords": [
    "rea",
    "rea-agents",
    "reverse-engineer-anything",
    "reverse-engineering",
    "ai-agents",
    "code-generation",
    "clean-room",
    "software-fusion",
    "cli"
  ]
}
